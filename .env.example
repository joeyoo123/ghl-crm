# Vercel Postgres (automatically set when you add Vercel Postgres storage)
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Or use DATABASE_URL directly
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth
NEXTAUTH_SECRET="change-me-in-production-use-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI - required for AI conversation features
OPENAI_API_KEY="your-openai-api-key-here"
